<?xml version="1.0" encoding="utf-8" ?>
<!--
  If you are an SRS Developer modifying this file in the VS project for committing then you must update the hard-coded
  logging configuration in App.xaml.cs as well to keep the changes in sync.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <!-- A null target to explicitly drop logs we don't want (Trace/Debug) -->
    <target name="nullTarget" xsi:type="Null" />

    <target name="asyncFileTarget" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard" >
      <target name="fileTarget"
              xsi:type="File"
              fileName="clientlog.txt"
              archiveFileName="clientlog.old.txt"
              archiveAboveSize="104857600"
              maxArchiveFiles="1"
              layout="${longdate} | ${logger} | ${message} ${exception:format=toString,Data:maxInnerExceptionLevel=1}"
      />
    </target>
    <target name="asyncConsoleTarget" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard" >
      <target name="consoleTarget"
              xsi:type="Console"
              encoding="utf-8"
              stdErr="false"
              detectConsoleAvailable="true"
              writeBuffer="false"
              layout="${longdate} | ${logger} (${level}) | ${message} ${exception:format=toString,Data:maxInnerExceptionLevel=1}"
      />
    </target>
  </targets>

  <rules>
    <!-- Allow Debug logs for specific audio classes/namespaces we want to inspect. These rules are evaluated before the global suppression. -->
    <logger name="Vanguard.VCS.Client.Audio.Providers.JitterBufferProviderInterface" minlevel="Debug" writeTo="asyncFileTarget,asyncConsoleTarget" />
    <logger name="Vanguard.VCS.Client.Audio.Providers.RadioMixingProvider" minlevel="Debug" writeTo="asyncFileTarget,asyncConsoleTarget" />
    <logger name="Vanguard.VCS.Client.Audio.Providers.ClientAudioProvider" minlevel="Debug" writeTo="asyncFileTarget,asyncConsoleTarget" />
    <logger name="Vanguard.VCS.Client.Audio.Providers.ClientEffectsPipeline" minlevel="Debug" writeTo="asyncFileTarget,asyncConsoleTarget" />
    <logger name="Vanguard.VCS.Client.Audio.Managers.AudioManager" minlevel="Debug" writeTo="asyncFileTarget,asyncConsoleTarget" />

    <!-- Suppress Trace/Debug globally by routing them to the null target and stopping rule processing for all other loggers -->
    <logger name="*" minlevel="Trace" maxlevel="Debug" writeTo="nullTarget" final="true" />

    <!-- Write Info+ to file for all loggers -->
    <logger name="*" minlevel="Info" writeTo="asyncFileTarget" />

    <!-- Reduce console noise: show Info+ by default on console -->
    <logger name="*" minlevel="Info" writeTo="asyncConsoleTarget" />

    <!-- NOTE: removed the special Trace rule for audio providers to prevent excessive debug/trace logs -->
  </rules>
</nlog>