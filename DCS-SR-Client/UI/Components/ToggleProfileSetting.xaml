<UserControl
    d:DesignHeight="50"
    d:DesignWidth="400"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.Components.ToggleProfileSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid DataContext="{Binding}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="10,0,0,0" Width="330">
                <TextBlock
                    FontSize="15"
                    Height="20"
                    Margin="0,11,0,0"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                <TextBlock
                    FontSize="10"
                    Height="16"
                    Margin="0,-2,0,0"
                    Text="{Binding SubTitle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            </StackPanel>
            <ToggleButton
                Checked="ToggleButton_OnChecked"
                HorizontalAlignment="Right"
                Unchecked="ToggleButton_OnUnchecked"
                x:Name="ToggleButton" />
        </StackPanel>
        <Separator
            BorderBrush="Black"
            BorderThickness="1"
            VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
