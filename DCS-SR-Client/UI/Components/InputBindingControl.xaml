<UserControl
    BorderBrush="Black"
    BorderThickness="0,1,0,0"
    d:DesignHeight="100"
    d:DesignWidth="500"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.Components.InputBindingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />

        </Grid.RowDefinitions>


        <Label
            BorderBrush="Black"
            BorderThickness="0,0,1,0"
            Content="Control"
            Grid.Column="0"
            Grid.Row="0"
            VerticalContentAlignment="Center"
            x:Name="DeviceLabel" />
        <TextBox
            Grid.Column="1"
            Grid.Row="0"
            IsEnabled="False"
            Text="None"
            TextAlignment="Center"
            TextWrapping="Wrap"
            VerticalContentAlignment="Center"
            x:Name="Device" />
        <TextBox
            Grid.Column="2"
            Grid.Row="0"
            IsEnabled="False"
            Text="None"
            TextAlignment="Center"
            VerticalContentAlignment="Center"
            x:Name="DeviceText" />
        <Button
            Click="Device_Click"
            Content="Set "
            Grid.Column="3"
            Grid.Row="0"
            Style="{DynamicResource SquareButtonStyle}"
            x:Name="DeviceButton" />
        <Button
            Click="DeviceClear_Click"
            Content="Clear"
            Grid.Column="4"
            Grid.Row="0"
            Style="{DynamicResource SquareButtonStyle}"
            x:Name="DeviceClear" />

        <Label
            BorderBrush="Black"
            BorderThickness="0,0,1,0"
            Content="Control"
            Grid.Column="0"
            Grid.Row="1"
            VerticalContentAlignment="Center"
            x:Name="ModifierLabel" />
        <TextBox
            Grid.Column="1"
            Grid.Row="1"
            IsEnabled="False"
            Text="None"
            TextAlignment="Center"
            TextWrapping="Wrap"
            VerticalContentAlignment="Center"
            x:Name="ModifierDevice" />
        <TextBox
            Grid.Column="2"
            Grid.Row="1"
            IsEnabled="False"
            Text="None"
            TextAlignment="Center"
            VerticalContentAlignment="Center"
            x:Name="ModifierText" />
        <Button
            Click="Modifier_Click"
            Content="Set "
            Grid.Column="3"
            Grid.Row="1"
            Style="{DynamicResource SquareButtonStyle}"
            x:Name="ModifierButton" />
        <Button
            Click="ModifierClear_Click"
            Content="Clear"
            Grid.Column="4"
            Grid.Row="1"
            Style="{DynamicResource SquareButtonStyle}"
            x:Name="ModifierButtonClear" />

    </Grid>


</UserControl>