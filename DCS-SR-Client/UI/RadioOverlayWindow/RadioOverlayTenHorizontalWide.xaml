<Window
    AllowsTransparency="True"
    Background="#444"
    Height="127"
    MinHeight="127"
    MinWidth="1650"
    Name="RadioOverlayWin"
    Opacity="1.0"
    ResizeMode="CanResizeWithGrip"
    Style="{x:Null}"
    Title="DCS-SimpleRadio"
    Topmost="True"
    Width="1650"
    WindowStyle="None"
    x:Class="Vanguard.VCS.Client.UI.RadioOverlayWindow.RadioOverlayWindowTenHorizontalWide"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:awacsRadioOverlayWindow="clr-namespace:Vanguard.VCS.Client.UI.AwacsRadioOverlayWindow"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Name="containerPanel"
        SizeChanged="containerPanel_SizeChanged"
        Style="{x:Null}">

        <Grid.LayoutTransform>
            <ScaleTransform CenterX="0" CenterY="0" ScaleX="{Binding ElementName=RadioOverlayWin, Path=ScaleValue}" ScaleY="{Binding ElementName=RadioOverlayWin, Path=ScaleValue}" x:Name="ApplicationScaleTransform" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />

        </Grid.RowDefinitions>

        <StackPanel
            Grid.Column="0"
            Grid.ColumnSpan="11"
            Grid.Row="0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <TextBlock
                FontSize="8"
                Foreground="#E7E7E7"
                Height="12"
                Margin="5,0,0,0"
                Name="ControlText"
                Padding="0"
                Text="10 Radio Panel"
                VerticalAlignment="Center"
                Width="1430" />
            <TextBlock
                FontSize="8"
                Foreground="#E7E7E7"
                Name="ControlSubText"
                Text="VNGD is best"
                TextAlignment="Center"
                VerticalAlignment="Center"
                Width="100">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock
                FontSize="8"
                Foreground="#E7E7E7"
                Height="12"
                Margin="5,0,0,0"
                Name="Orientation"
                Padding="0"
                Text="Horizontal"
                VerticalAlignment="Center"
                Width="38" />
            <Button
                Click="Button_Swap_Orientation"
                Height="15"
                Margin="0,0,2,0"
                Style="{StaticResource DarkStyle-Button}"
                ToolTip="Swap to vertical orientation">
                <Grid Height="10" Width="10">
                    <Image Source="pack://application:,,,/SR-ClientRadio;component/SRS_Orientation_Toggle.png" />
                </Grid>
            </Button>

            <Button
                Click="ShowOverlayMenuSelect_OnClick"
                Height="15"
                Margin="0,0,5,0"
                Style="{StaticResource DarkStyle-Button}"
                VerticalAlignment="Center">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontSize="10"
                            HorizontalAlignment="Center"
                            Padding="0,0,0,1"
                            Text="M"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>


            <Button
                Click="Button_Minimise"
                Height="15"
                Margin="0,0,0,0"
                Style="{StaticResource DarkStyle-Button}"
                VerticalAlignment="Center">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontFamily="Marlett"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Padding="3.5,0,0,3"
                            Text="0"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button
                Click="Button_Close"
                Height="15"
                Margin="2,0,5,0"
                Style="{StaticResource DarkStyle-Button}"
                VerticalAlignment="Center">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontFamily="Marlett"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Padding="0,0,0,1"
                            Text="r"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>

        </StackPanel>

        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="1"
            RadioId="1"
            x:Name="radio1" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="1"
            Grid.Row="1"
            RadioId="2"
            x:Name="radio2" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="2"
            Grid.Row="1"
            RadioId="3"
            x:Name="radio3" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="3"
            Grid.Row="1"
            RadioId="4"
            x:Name="radio4" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="4"
            Grid.Row="1"
            RadioId="5"
            x:Name="radio5" />


        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="5"
            Grid.Row="1"
            RadioId="6"
            x:Name="radio6" />

        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="6"
            Grid.Row="1"
            RadioId="7"
            x:Name="radio7" />

        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="7"
            Grid.Row="1"
            RadioId="8"
            x:Name="radio8" />

        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="8"
            Grid.Row="1"
            RadioId="9"
            x:Name="radio9" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="9"
            Grid.Row="1"
            RadioId="10"
            x:Name="radio10" />

        <StackPanel
            Grid.Column="0"
            Grid.ColumnSpan="10"
            Grid.Row="2"
            HorizontalAlignment="Center"
            Margin="0,0,0,0"
            Orientation="Horizontal"
            VerticalAlignment="Center">

            <awacsRadioOverlayWindow:IntercomControlGroup
                HorizontalAlignment="Center"
                Margin="0,0,0,0"
                RadioId="0"
                x:Name="intercom" />

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    FontSize="12"
                    Foreground="#E7E7E7"
                    HorizontalAlignment="Center"
                    Margin="10,0,0,0"
                    Padding="0"
                    Style="{x:Null}"
                    Text="PANEL TRANSPARENCY"
                    TextAlignment="Center"
                    VerticalAlignment="Center"
                    Width="140"
                    x:Name="TrancparencyLabel" />

                <Slider
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    Margin="10,0,0,0"
                    Maximum="1.0"
                    Minimum="0.05"
                    Opacity="0.6"
                    Style="{x:Null}"
                    ToolTip="Window Opacity"
                    Value="1.0"
                    ValueChanged="windowOpacitySlider_ValueChanged"
                    VerticalAlignment="Center"
                    Width="140"
                    x:Name="windowOpacitySlider" />
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>