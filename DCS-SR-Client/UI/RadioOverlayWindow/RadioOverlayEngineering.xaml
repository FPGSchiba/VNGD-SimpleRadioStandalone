<Window
    AllowsTransparency="True"
    Background="#444"
    Height="200"
    LocationChanged="RadioOverlayWindow_OnLocationChanged"
    MinHeight="200"
    MinWidth="178"
    Name="RadioOverlayWin"
    Opacity="1.0"
    ResizeMode="CanResizeWithGrip"
    Style="{x:Null}"
    Title="DCS-SimpleRadio"
    Topmost="True"
    Width="180"
    WindowStyle="None"
    x:Class="Vanguard.VCS.Client.UI.RadioOverlayWindow.RadioOverlayWindowEngineering"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:awacsOverlayWindow="clr-namespace:Vanguard.VCS.Client.UI.AwacsRadioOverlayWindow"
    xmlns:local="clr-namespace:Vanguard.VCS.Client.UI.RadioOverlayWindow"
    xmlns:utils="clr-namespace:Vanguard.VCS.Client.UI.RadioOverlayWindow.Utils"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <WrapPanel
        HorizontalAlignment="Center"
        Margin="0,0,0,0"
        Name="ContainerPanel"
        SizeChanged="containerPanel_SizeChanged"
        Style="{x:Null}">

        <WrapPanel.LayoutTransform>
            <ScaleTransform CenterX="0" CenterY="0" ScaleX="{Binding ElementName=RadioOverlayWin, Path=ScaleValue}" ScaleY="{Binding ElementName=RadioOverlayWin, Path=ScaleValue}" x:Name="ApplicationScaleTransform" />
        </WrapPanel.LayoutTransform>

        <StackPanel
            Name="Header"
            Orientation="Horizontal"
            Width="180">
            <TextBlock
                FontSize="8"
                Foreground="#E7E7E7"
                Height="12"
                Margin="2,0,0,0"
                Name="ControlText"
                Padding="0"
                Text="Compact Radio Panel - Original"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
                Width="130" />
            <TextBlock
                FontSize="8"
                Foreground="#E7E7E7"
                Height="12"
                Margin="0,0,0,0"
                Name="Orientation"
                Padding="0"
                Text="Vertical"
                TextWrapping="NoWrap"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Width="28" />

            <Button
                Click="ShowOverlayMenuSelect_OnClick"
                Height="15"
                Margin="0,0,3,0"
                Style="{StaticResource DarkStyle-Button}"
                VerticalAlignment="Center">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontSize="10"
                            HorizontalAlignment="Center"
                            Padding="0,0,0,1"
                            Text="M"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button
                Click="Button_Minimise"
                Margin="0,0,0,0"
                Name="buttonMinimize"
                Style="{StaticResource DarkStyle-Button}">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontFamily="Marlett"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Padding="3.5,0,0,3"
                            Text="0"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button
                Click="Button_Close"
                Margin="2,0,0,0"
                Name="buttonClose"
                Style="{StaticResource DarkStyle-Button}">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontFamily="Marlett"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Padding="0,0,0,1"
                            Text="r"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>
        </StackPanel>


        <StackPanel
            HorizontalAlignment="Center"
            Margin="0,2,0,0"
            Orientation="Vertical"
            SnapsToDevicePixels="True"
            VerticalAlignment="Center"
            Width="180">
            <awacsOverlayWindow:RadioControlGroupSwitch
                Margin="0,0,0,0"
                RadioId="1"
                Visibility="Visible"
                x:Name="Radio1" />
            <awacsOverlayWindow:RadioControlGroupSwitch
                Margin="0,0,0,0"
                RadioId="2"
                Visibility="Visible"
                x:Name="Radio2" />
            <awacsOverlayWindow:RadioControlGroupSwitch
                Margin="0,0,0,0"
                RadioId="3"
                Visibility="Visible"
                x:Name="Radio3" />

            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,2,0,0"
                Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                        Click="Button_ShowAllRadios"
                        Height="15"
                        Margin="2,0,2,0"
                        Name="buttonShow"
                        RenderTransformOrigin="0.5, 0.5"
                        Style="{StaticResource DarkStyle-Button}"
                        Width="35">
                        <Button.Content>
                            <TextBlock
                                FontSize="8"
                                HorizontalAlignment="Center"
                                Name="buttonShowText"
                                Padding="0,0,0,.5"
                                Text="Hide"
                                VerticalAlignment="Center" />
                        </Button.Content>
                    </Button>
                    <Button
                        Background="#FF777777"
                        Click="Button_Expand"
                        Height="15"
                        Margin="5,1,5,1"
                        Name="buttonExpand"
                        Style="{StaticResource DarkStyle-Button}"
                        Width="15">
                        <Button.Content>
                            <Viewbox
                                Height="10"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,0"
                                Stretch="Fill"
                                VerticalAlignment="Center"
                                Width="10">
                                <TextBlock
                                    FontSize="1"
                                    Foreground="Transparent"
                                    Height="8"
                                    Name="buttonExpandText"
                                    Text="expand"
                                    Width="20">
                                    <TextBlock.Background>
                                        <ImageBrush ImageSource="/ContractIcon.png" Stretch="Fill" />
                                    </TextBlock.Background>
                                </TextBlock>
                            </Viewbox>
                        </Button.Content>
                    </Button>
                </StackPanel>
                <utils:IntercomControlGroupTransparent
                    Margin="0,0,0,0"
                    RadioId="0"
                    Width="110"
                    x:Name="Intercom" />
            </StackPanel>
        </StackPanel>

        <StackPanel Name="Footer" Orientation="Vertical">
            <Separator Margin="0,0,0,0" Width="170" />

            <StackPanel
                HorizontalAlignment="Left"
                Margin="1,1,5,0"
                Orientation="Horizontal">

                <StackPanel
                    Margin="0,0,0,0"
                    Name="textBackground"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="6"
                        Foreground="#E7E7E7"
                        HorizontalAlignment="Center"
                        Margin="2,0,0,0"
                        Padding="0,0,0,0"
                        Style="{x:Null}"
                        Text="Background"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Width="35" />

                    <Viewbox
                        DockPanel.Dock="Right"
                        Height="8"
                        Stretch="Fill"
                        VerticalAlignment="Center"
                        Width="40">
                        <Slider
                            Margin="2,0,0,0"
                            Maximum="1.0"
                            Minimum="0.0"
                            Opacity="0.6"
                            Style="{x:Null}"
                            ToolTip="Panel Opacity"
                            Value="1"
                            ValueChanged="backgroundOpacitySlider_ValueChanged"
                            VerticalAlignment="Center"
                            Width="100"
                            x:Name="BackgroundOpacitySlider" />
                    </Viewbox>
                </StackPanel>
                <StackPanel
                    Margin="2,0,0,0"
                    Name="textText"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="6"
                        Foreground="#E7E7E7"
                        HorizontalAlignment="Center"
                        Margin="2,0,0,0"
                        Padding="0,0,0,0"
                        Style="{x:Null}"
                        Text="Text"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Width="35" />

                    <Viewbox
                        DockPanel.Dock="Right"
                        Height="8"
                        Stretch="Fill"
                        VerticalAlignment="Center"
                        Width="40">
                        <Slider
                            Margin="2,0,0,0"
                            Maximum="1.0"
                            Minimum="0.20"
                            Opacity="0.6"
                            Style="{x:Null}"
                            ToolTip="Panel Opacity"
                            Value="0.1"
                            ValueChanged="textOpacitySlider_ValueChanged"
                            VerticalAlignment="Center"
                            Width="100"
                            x:Name="TextOpacitySlider" />
                    </Viewbox>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock
                    FontSize="6"
                    Foreground="#E7E7E7"
                    HorizontalAlignment="Center"
                    Margin="2,3,0,0"
                    Padding="0,0,0,0"
                    Style="{x:Null}"
                    Text="ENGINEERING &amp; DAMAGE CONTROL"
                    VerticalAlignment="Center" />

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        FontSize="8"
                        Foreground="#FF9900"
                        HorizontalAlignment="Center"
                        Padding="1"
                        Text="Ship Condition"
                        VerticalAlignment="Center" />
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="15"
                        Margin="3"
                        Name="ShipConditionCode"
                        Padding="0"
                        Width="15">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="1"
                            VerticalAlignment="Center" />
                    </Border>
                    <Button
                        Background="IndianRed"
                        Click="ShipConditionChangeResponse_Click"
                        Height="15"
                        HorizontalAlignment="Center"
                        Margin="3"
                        Padding="0"
                        Style="{StaticResource DarkStyle-Button}"
                        Visibility="Visible"
                        Width="25"
                        x:Name="RadioEnabled">
                        <Button.Content>
                            <TextBlock
                                FontSize="7"
                                Foreground="Black"
                                Text="READY" />
                        </Button.Content>
                    </Button>
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="15"
                        Margin="20,3,3,3"
                        Name="DCCrewStatus"
                        Padding="0"
                        Width="25">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="CREW"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="15"
                        Margin="3"
                        Name="DCCritical"
                        Padding="0"
                        Width="15">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="!!!"
                            VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="20"
                        Margin="3"
                        Name="DCShield"
                        Padding="0"
                        Width="20">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="SH"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="20"
                        Margin="3"
                        Name="DCQuantumDrive"
                        Padding="0"
                        Width="20">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="QD"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="20"
                        Margin="3"
                        Name="DCEngine"
                        Padding="0"
                        Width="20">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="ENG"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="20"
                        Margin="3"
                        Name="DCGuns"
                        Padding="0"
                        Width="20">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="GUN"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="20"
                        Margin="3"
                        Name="DCMissile"
                        Padding="0"
                        Width="20">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="MIS"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="20"
                        Margin="3"
                        Name="DCTorpedo"
                        Padding="0"
                        Width="20">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="TOR"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        Background="CadetBlue"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Height="20"
                        Margin="3"
                        Name="DCCooler"
                        Padding="0"
                        Width="20">
                        <TextBlock
                            FontSize="8"
                            Foreground="#FF9900"
                            HorizontalAlignment="Center"
                            Padding="1"
                            Text="CL"
                            VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </WrapPanel>
</Window>