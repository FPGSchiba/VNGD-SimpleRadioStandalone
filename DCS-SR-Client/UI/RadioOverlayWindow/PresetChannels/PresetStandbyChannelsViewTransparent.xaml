<UserControl
    Height="10"
    Width="12"
    d:DataContext="{d:DesignInstance presetChannels1:PresetStandbyChannelsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="10"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.RadioOverlayWindow.PresetChannels.PresetStandbyChannelsViewTransparent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvmEventBinding="clr-namespace:MvvmEventBinding;assembly=MvvmEventBinding"
    xmlns:presetChannels1="clr-namespace:Vanguard.VCS.Client.UI.RadioOverlayWindow.PresetChannels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <WrapPanel
        Background="#444"
        HorizontalAlignment="Center"
        Orientation="Horizontal"
        Width="12">
        <ComboBox
            DropDownClosed="{mvvmEventBinding:EventBinding DropDownClosedCommand}"
            FontSize="12"
            Height="10"
            HorizontalAlignment="Right"
            ItemsSource="{Binding PresetChannels}"
            SelectedItem="{Binding SelectedPresetChannel}"
            ToolTip="Select a predefined radio frequency via a dropdown menu"
            VerticalAlignment="Top"
            Width="12"
            x:Name="FrequencyDropDown">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        FontSize="12"
                        Height="18"
                        Text="{Binding Path=Text}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <!--<Button Name="ReloadButton"
                Width="8"
                Height="10"
                FontSize="6"
                Padding="0"
                VerticalAlignment="Center"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                Command="{Binding Path=ReloadCommand}"
                Content="R"
                Style="{x:Null}"
                ToolTip="Refresh the channel dropdown list"/>-->

    </WrapPanel>
</UserControl>