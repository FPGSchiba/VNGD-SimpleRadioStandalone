<Window
    AllowsTransparency="True"
    Background="#444"
    Height="905"
    MinHeight="905"
    MinWidth="170"
    Name="RadioOverlayWin"
    Opacity="1.0"
    ResizeMode="CanResizeWithGrip"
    Style="{x:Null}"
    Title="DCS-SimpleRadio"
    Topmost="True"
    Width="170"
    WindowStyle="None"
    x:Class="Vanguard.VCS.Client.UI.RadioOverlayWindow.RadioOverlayWindowTenVerticalLong"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:awacsRadioOverlayWindow="clr-namespace:Vanguard.VCS.Client.UI.AwacsRadioOverlayWindow"
    xmlns:utils="clr-namespace:Vanguard.VCS.Client.UI.RadioOverlayWindow.Utils"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Margin="0,0,0,0"
        Name="containerPanel"
        SizeChanged="containerPanel_SizeChanged"
        Style="{x:Null}">

        <Grid.LayoutTransform>
            <ScaleTransform CenterX="0" CenterY="0" ScaleX="{Binding ElementName=RadioOverlayWin, Path=ScaleValue}" ScaleY="{Binding ElementName=RadioOverlayWin, Path=ScaleValue}" x:Name="ApplicationScaleTransform" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="16" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <StackPanel
            Grid.Column="0"
            Grid.Row="0"
            HorizontalAlignment="Left"
            Margin="5,0,0,0"
            Orientation="Horizontal"
            Width="165">
            <TextBlock
                FontSize="8"
                Foreground="#E7E7E7"
                Height="12"
                Margin="2,0,0,0"
                Name="ControlText"
                Padding="0"
                Text="10 Radio Panel"
                VerticalAlignment="Center"
                Width="63" />
            <TextBlock
                FontSize="8"
                Foreground="#E7E7E7"
                Height="12"
                Margin="5,0,0,0"
                Name="Orientation"
                Padding="0"
                Text="Vertical"
                VerticalAlignment="Center"
                Width="28" />
            <Button
                Click="Button_Swap_Orientation"
                Margin="0,0,2,0"
                Style="{StaticResource DarkStyle-Button}"
                ToolTip="Swap to horizon orientation">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <Image Source="pack://application:,,,/VCS-RadioClient;component/SRS_Orientation_Toggle.png" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button
                Click="ShowOverlayMenuSelect_OnClick"
                Height="15"
                Margin="0,0,3,0"
                Style="{StaticResource DarkStyle-Button}"
                VerticalAlignment="Center">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontSize="10"
                            HorizontalAlignment="Center"
                            Padding="0,0,0,1"
                            Text="M"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button
                Click="Button_Minimise"
                Height="15"
                Margin="0,0,0,0"
                Style="{StaticResource DarkStyle-Button}"
                VerticalAlignment="Center">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontFamily="Marlett"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Padding="3.5,0,0,3"
                            Text="0"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button
                Click="Button_Close"
                Height="15"
                Margin="2,0,5,0"
                Style="{StaticResource DarkStyle-Button}"
                VerticalAlignment="Center">
                <Button.Content>
                    <Grid Height="10" Width="10">
                        <TextBlock
                            FontFamily="Marlett"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Padding="0,0,0,1"
                            Text="r"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button.Content>
            </Button>

        </StackPanel>

        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="1"
            Margin="2,0,2,0"
            RadioId="1"
            x:Name="radio1" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="2"
            Margin="2,0,2,0"
            RadioId="2"
            x:Name="radio2" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="3"
            Margin="2,0,2,0"
            RadioId="3"
            x:Name="radio3" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="4"
            Margin="2,0,2,0"
            RadioId="4"
            x:Name="radio4" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="5"
            Margin="2,0,2,0"
            RadioId="5"
            x:Name="radio5" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="6"
            Margin="2,0,2,0"
            RadioId="6"
            x:Name="radio6" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="7"
            Margin="2,0,2,0"
            RadioId="7"
            x:Name="radio7" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="8"
            Margin="2,0,2,0"
            RadioId="8"
            x:Name="radio8" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="9"
            Margin="2,0,2,0"
            RadioId="9"
            x:Name="radio9" />
        <awacsRadioOverlayWindow:RadioControlGroup
            Grid.Column="0"
            Grid.Row="10"
            Margin="2,0,2,0"
            RadioId="10"
            x:Name="radio10" />
        <StackPanel
            Grid.Column="0"
            Grid.Row="12"
            HorizontalAlignment="Center"
            Orientation="Vertical"
            VerticalAlignment="Center">

            <Separator
                Height="1"
                Margin="0,2,0,2"
                Width="170" />

            <TextBlock
                FontSize="10"
                Foreground="#E7E7E7"
                Grid.Column="0"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Margin="0,0,0,0"
                Padding="0"
                Style="{x:Null}"
                Text="PANEL TRANSPARENCY"
                TextAlignment="Center"
                VerticalAlignment="Center"
                Width="130"
                x:Name="TrancparencyLabel" />

            <Slider
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="2"
                Height="20"
                HorizontalAlignment="Center"
                Margin="0,0,5,0"
                Maximum="1.0"
                Minimum="0.05"
                Opacity="0.6"
                Style="{x:Null}"
                ToolTip="Window Opacity"
                Value="1.0"
                ValueChanged="windowOpacitySlider_ValueChanged"
                VerticalAlignment="Center"
                Width="120"
                x:Name="windowOpacitySlider" />
        </StackPanel>

        <utils:IntercomControlGroup
            Grid.Column="0"
            Grid.Row="11"
            HorizontalAlignment="Center"
            Margin="2,0,2,0"
            RadioId="0"
            x:Name="intercom" />

    </Grid>
</Window>