<UserControl
    Height="18"
    Name="RadioControlContainer"
    Width="360"
    x:Class="Vanguard.VCS.Client.UI.RadioOverlayWindow.Utils.IntercomControlGroup3Horizontal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <StackPanel Margin="3,0,3,0" Orientation="Horizontal">
        <WrapPanel HorizontalAlignment="Left">
            <TextBlock
                FontSize="10"
                Foreground="#E7E7E7"
                HorizontalAlignment="Center"
                Padding="0,0,0,0"
                Style="{x:Null}"
                Text="VOX / INTERCOM"
                TextAlignment="Center"
                VerticalAlignment="Center"
                Width="90"
                x:Name="RadioLabel" />

            <Slider
                Height="20"
                IsEnabled="True"
                Margin="0,0,3,0"
                Maximum="100"
                Style="{x:Null}"
                Thumb.DragCompleted="RadioVolume_DragCompleted"
                Thumb.DragStarted="RadioVolume_DragStarted"
                VerticalAlignment="Center"
                Width="60"
                x:Name="RadioVolume" />

            <xctk:IntegerUpDown
                Height="18"
                Value="1"
                ValueChanged="IntercomNumber_SpinnerChanged"
                VerticalAlignment="Center"
                Width="40"
                x:Name="IntercomNumberSpinner" />

            <Ellipse
                Fill="#FF9900"
                Height="12"
                HorizontalAlignment="Right"
                Margin="2"
                MouseDown="RadioSelectSwitch"
                Stroke="Black"
                Style="{x:Null}"
                ToolTip="Selected Radio"
                VerticalAlignment="Center"
                Width="12"
                x:Name="RadioActive" />

        </WrapPanel>

        <Line
            Margin="5,0,2,0"
            Stroke="#ACACAC"
            StrokeThickness="2"
            X1="0"
            X2="0"
            Y1="0"
            Y2="50" />

        <WrapPanel
            Margin="2,0,0,0"
            ToolTip="Select the VOX Input mode you want to use. (Intercom Channel 1 Disabled)"
            Width="138">
            <TextBlock
                FontSize="9"
                Foreground="#E7E7E7"
                HorizontalAlignment="Center"
                Margin="2,0,2,0"
                Padding="0,0,0,0"
                Style="{x:Null}"
                Text="VOX SEL"
                TextAlignment="Center"
                VerticalAlignment="Center"
                Width="40"
                x:Name="VOXLabel" />

            <Button
                Click="VoxR1Enabled_OnClick"
                Content="R1"
                FontSize="9"
                Foreground="Black"
                Height="18"
                IsEnabled="True"
                Margin="0,0,2,0"
                Padding="0,-1.5,0,0"
                Style="{StaticResource DarkStyle-Button}"
                ToolTip="enable / disable voice activated communications for Radio 1"
                VerticalAlignment="Center"
                Width="40"
                x:Name="Radio1Enabled" />

            <Button
                Click="VoxICEnabled_OnClick"
                Content="IC"
                FontSize="9"
                Foreground="Black"
                Height="18"
                IsEnabled="False"
                Margin="2,0,0,0"
                Padding="0,-1.5,0,0"
                Style="{StaticResource DarkStyle-Button}"
                ToolTip="enable / disable voice activated communications for Intercom (Channel 1 Disabled)"
                VerticalAlignment="Center"
                Width="40"
                x:Name="IntercomEnabled" />
        </WrapPanel>
    </StackPanel>
</UserControl>