<UserControl
    Height="10"
    Name="RadioControlContainerTransparent"
    Width="172"
    x:Class="Vanguard.VCS.Client.UI.AwacsRadioOverlayWindow.RadioControlGroupTransparent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:presetChannels="clr-namespace:Vanguard.VCS.Client.UI.RadioOverlayWindow.PresetChannels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <StackPanel
        Background="Transparent"
        HorizontalAlignment="Left"
        Orientation="Horizontal"
        SnapsToDevicePixels="True"
        VerticalAlignment="Center">
        <Button
            Background="IndianRed"
            Click="ToggleSwitch_Click"
            FontSize="5"
            Foreground="Black"
            Height="10"
            HorizontalAlignment="Center"
            IsEnabled="False"
            Margin="1,0,0,0"
            Name="RadioEnabled"
            Opacity="1"
            Padding="0"
            Style="{StaticResource DarkStyle-Button}"
            Width="15">
            <Button.Content>
                <TextBlock FontSize="5" Text="Off" />
            </Button.Content>
        </Button>
        <!--<Button
             Background="DarkGray"
             Click="ToggleChannel_Click"
             Opacity="1"
             FontSize="5"
             FontWeight="Black"
             Foreground="Black"
             Height="10"
             IsEnabled="False"
             Margin="1,0,0,0"
             Name="ChannelEnabled"
             Style="{StaticResource DarkStyle-Button}"
             Width="10">
            <Button.Content>
                <Grid Width="10" Height="10">
                    <TextBlock
                       Name="ChannelEnableText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Padding="2,1.5,6,8"
                       Text="»" />
                </Grid>
            </Button.Content>
        </Button>-->
        <presetChannels:PresetChannelsViewTransparent1
            Background="#444"
            DataContext="{Binding ChannelViewModel, Mode=TwoWay}"
            HorizontalAlignment="Center"
            Width="12"
            x:Name="PresetChannelsView" />
        <StackPanel
            Background="Black"
            Margin="1,0,0,0"
            Name="RadioTextGroup"
            Orientation="Horizontal">
            <TextBlock
                Background="Transparent"
                FontSize="8"
                Foreground="#00FF00"
                Height="10"
                HorizontalAlignment="Center"
                Margin="0,0,0,0"
                Padding="0"
                Style="{x:Null}"
                Text="Radio 10"
                TextWrapping="NoWrap"
                VerticalAlignment="Center"
                Width="43"
                x:Name="RadioLabel">
                <Border BorderBrush="Black" BorderThickness="0" />
            </TextBlock>
            <TextBox
                Background="Black"
                BorderBrush="Black"
                BorderThickness="0"
                FontSize="8"
                Foreground="#00FF00"
                Height="10"
                HorizontalAlignment="Left"
                HorizontalScrollBarVisibility="Disabled"
                MouseDown="RadioFrequencyText_Click"
                MouseRightButtonDown="RadioFrequencyText_RightClick"
                Padding="0"
                PreviewMouseWheel="RadioFrequencyText_MouseWheel"
                Style="{x:Null}"
                Text="000.000"
                TextAlignment="Center"
                TextWrapping="NoWrap"
                VerticalAlignment="Center"
                VerticalScrollBarVisibility="Disabled"
                Visibility="Visible"
                Width="30"
                x:Name="RadioFrequency" />
            <TextBlock
                Background="Transparent"
                FontSize="8"
                Foreground="#00FF00"
                Height="10"
                HorizontalAlignment="Center"
                MouseDown="RadioFrequencyText_Click"
                MouseRightButtonDown="RadioFrequencyText_RightClick"
                Padding="0"
                Style="{x:Null}"
                Text="AM 👤10"
                TextAlignment="Center"
                TextWrapping="NoWrap"
                VerticalAlignment="Center"
                Visibility="Visible"
                Width="35"
                x:Name="RadioMetaData">
                <Border BorderBrush="Black" BorderThickness="0" />
            </TextBlock>
            <TextBlock
                Background="Black"
                FontSize="8"
                Foreground="#00FF00"
                Height="10"
                HorizontalAlignment="Center"
                Style="{x:Null}"
                Text="USER"
                TextAlignment="Center"
                TextWrapping="NoWrap"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Width="65"
                x:Name="TransmitterName" />
        </StackPanel>
        <Ellipse
            Fill="#FF9900"
            Height="10"
            HorizontalAlignment="Right"
            Margin="1,0,0,0"
            MouseDown="RadioSelectSwitch"
            Stroke="Black"
            Style="{x:Null}"
            ToolTip="Selected Radio"
            VerticalAlignment="Center"
            Width="10"
            x:Name="RadioActive" />
        <Viewbox DockPanel.Dock="Right" Stretch="Fill">
            <Slider
                Height="20"
                IsEnabled="False"
                Margin="3,2,0,0"
                Maximum="100"
                Style="{x:Null}"
                Thumb.DragCompleted="RadioVolume_DragCompleted"
                Thumb.DragStarted="RadioVolume_DragStarted"
                Width="40"
                x:Name="RadioVolume" />
        </Viewbox>
    </StackPanel>
</UserControl>