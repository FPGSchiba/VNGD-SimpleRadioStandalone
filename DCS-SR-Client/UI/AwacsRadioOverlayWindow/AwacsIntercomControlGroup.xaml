<UserControl
    Height="35"
    Name="RadioControlContainer"
    Width="495"
    x:Class="Vanguard.VCS.Client.UI.AwacsRadioOverlayWindow.IntercomControlGroup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <StackPanel Margin="0,0,0,0" Orientation="Horizontal">

        <TextBlock
            FontSize="12"
            Foreground="#E7E7E7"
            Margin="2"
            Padding="0"
            Style="{x:Null}"
            Text="INTERCOM"
            TextAlignment="Center"
            VerticalAlignment="Center"
            Width="58"
            x:Name="RadioLabel" />
        <Ellipse
            Fill="#FF9900"
            Height="12"
            MouseDown="RadioSelectSwitch"
            Stroke="Black"
            Style="{x:Null}"
            ToolTip="Selected Radio"
            Width="12"
            x:Name="RadioActive" />
        <Slider
            Height="20"
            IsEnabled="False"
            Margin="2,2,0,2"
            Maximum="100"
            Style="{x:Null}"
            Thumb.DragCompleted="RadioVolume_DragCompleted"
            Thumb.DragStarted="RadioVolume_DragStarted"
            Width="115"
            x:Name="RadioVolume" />

        <TextBlock
            FontSize="9"
            Foreground="#E7E7E7"
            HorizontalAlignment="Center"
            Margin="2,2,2,2"
            Padding="0"
            Style="{x:Null}"
            Text="CHANNEL"
            TextAlignment="Center"
            VerticalAlignment="Center"
            Width="45"
            x:Name="ShipLabel" />
        <xctk:IntegerUpDown
            Height="20"
            Margin="5,0,8,0"
            Value="1"
            ValueChanged="IntercomNumber_SpinnerChanged"
            Width="50"
            x:Name="IntercomNumberSpinner" />

        <Line
            Margin="0,0,5,0"
            Stroke="#ACACAC"
            StrokeThickness="2"
            X1="0"
            X2="0"
            Y1="0"
            Y2="50" />

        <TextBlock
            FontSize="12"
            Foreground="#E7E7E7"
            Margin="2,2,5,2"
            Padding="0"
            Style="{x:Null}"
            Text="VOX SELECTION"
            TextAlignment="Center"
            VerticalAlignment="Center"
            Width="85"
            x:Name="VOXLabel" />

        <Button
            Click="VoxR1Enabled_OnClick"
            Content="R1"
            FontSize="9"
            Foreground="Black"
            Height="18"
            IsEnabled="True"
            Margin="2,0,2,0"
            Style="{StaticResource DarkStyle-Button}"
            ToolTip="enable / disable voice activated communications for Radio 1"
            Width="40"
            x:Name="Radio1Enabled" />

        <Button
            Click="VoxICEnabled_OnClick"
            Content="IC"
            FontSize="9"
            Foreground="Black"
            Height="18"
            IsEnabled="False"
            Margin="2,0,2,0"
            Style="{StaticResource DarkStyle-Button}"
            ToolTip="enable / disable voice activated communications for Intercom"
            Width="40"
            x:Name="IntercomEnabled" />

    </StackPanel>
</UserControl>