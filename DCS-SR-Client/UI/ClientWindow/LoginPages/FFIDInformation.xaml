<Window
    Height="500"
    ResizeMode="NoResize"
    Title="VCS - FFID Information"
    Width="450"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.ClientWindow.LoginPages.FFIDInformation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid DataContext="{Binding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="0,10,0,0"
            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
            Text="First Fleet Identification Codes"
            TextAlignment="Center" />
        <ListView Grid.Row="1" ItemsSource="{Binding Units}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        DisplayMemberBinding="{Binding Name}"
                        Header="Unit Name"
                        Width="300" />
                    <GridViewColumn DisplayMemberBinding="{Binding Code}" Header="Code" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
