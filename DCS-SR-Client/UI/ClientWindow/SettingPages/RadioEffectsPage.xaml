<Page
    Height="275"
    Title="RadioEffectsPage"
    Width="415"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.ClientWindow.SettingPages.RadioEffectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:components1="clr-namespace:Vanguard.VCS.Client.UI.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <Grid Height="50" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Label
                    Content="Radio Transmit (TX) Effects"
                    FontWeight="Bold"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Background="#E8DEF8"
                        BorderBrush="#79747E"
                        BorderThickness="1"
                        Click="TxStart_OnClick"
                        Foreground="Black"
                        HorizontalAlignment="Center"
                        Margin="0,0,20,0"
                        Padding="0"
                        Width="55"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        x:Name="TxStart">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,-4"
                                    Text="Start" />
                                <TextBlock
                                    FontSize="10"
                                    HorizontalAlignment="Center"
                                    Name="TxStartText"
                                    Text="On" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button
                        Background="#E8DEF8"
                        BorderBrush="#79747E"
                        BorderThickness="1"
                        Click="TxEnd_OnClick"
                        Foreground="Black"
                        HorizontalAlignment="Center"
                        Padding="0"
                        Width="55"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        x:Name="TxEnd">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,-4"
                                    Text="End" />
                                <TextBlock
                                    FontSize="10"
                                    HorizontalAlignment="Center"
                                    Name="TxEndText"
                                    Text="On" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>

            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="50" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Label
                    Content="Radio Receive (RX) Effects"
                    FontWeight="Bold"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Background="#E8DEF8"
                        BorderBrush="#79747E"
                        BorderThickness="1"
                        Click="RxStart_OnClick"
                        Foreground="Black"
                        HorizontalAlignment="Center"
                        Margin="0,0,20,0"
                        Padding="0"
                        Width="55"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        x:Name="RxStart">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,-4"
                                    Text="Start" />
                                <TextBlock
                                    FontSize="10"
                                    HorizontalAlignment="Center"
                                    Name="RxStartText"
                                    Text="On" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button
                        Background="#E8DEF8"
                        BorderBrush="#79747E"
                        BorderThickness="1"
                        Click="RxEnd_OnClick"
                        Foreground="Black"
                        HorizontalAlignment="Center"
                        Padding="0"
                        Width="55"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        x:Name="RxEnd">
                        <Button.Content>
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,-4"
                                    Text="End" />
                                <TextBlock
                                    FontSize="10"
                                    HorizontalAlignment="Center"
                                    Name="RxEndText"
                                    Text="On" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>

            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="50" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Label
                    Content="Radio Transmit Start Sound"
                    FontWeight="Bold"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <ComboBox
                    Grid.Column="1"
                    Height="30"
                    HorizontalAlignment="Center"
                    Padding="5"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    VerticalAlignment="Center"
                    Width="131"
                    x:Name="RadioStartTransmitEffect" />
            </Grid>

            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="50" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Label
                    Content="Radio Transmit End Sound"
                    FontWeight="Bold"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <ComboBox
                    Grid.Column="1"
                    Height="30"
                    HorizontalAlignment="Center"
                    Padding="5"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    VerticalAlignment="Center"
                    Width="131"
                    x:Name="RadioEndTransmitEffect" />
            </Grid>

            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="50" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Label
                    Content="Intercom Transmit Start Sound"
                    FontWeight="Bold"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <ComboBox
                    Grid.Column="1"
                    Height="30"
                    HorizontalAlignment="Center"
                    Padding="5"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    VerticalAlignment="Center"
                    Width="131"
                    x:Name="IntercomStartTransmitEffect" />
            </Grid>

            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="50" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Label
                    Content="Intercom Transmit End Sound"
                    FontWeight="Bold"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <ComboBox
                    Grid.Column="1"
                    Height="30"
                    HorizontalAlignment="Center"
                    Padding="5"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    VerticalAlignment="Center"
                    Width="131"
                    x:Name="IntercomEndTransmitEffect" />
            </Grid>

            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <components1:ToggleProfileSetting
                Height="50"
                SettingKey="RadioEncryptionEffects"
                SubTitle="Requires Tx or Rx effects on"
                Title="Radio Encryption Effects" />
            <components1:ToggleProfileSetting
                Height="50"
                SettingKey="RadioEffects"
                SubTitle="Client Side Only"
                Title="Enable Radio Voice Effect" />
            <components1:ToggleProfileSetting
                Height="50"
                SettingKey="RadioEffectsClipping"
                SubTitle="Requires Radio Effects On!"
                Title="Enable Clipping Effect" />
            <Separator
                BorderBrush="White"
                BorderThickness="25"
                VerticalAlignment="Bottom" />
        </StackPanel>
    </ScrollViewer>
</Page>
