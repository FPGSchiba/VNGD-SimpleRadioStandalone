<Page
    Height="270"
    Title="LegacyPage"
    Width="415"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.ClientWindow.SettingPages.LegacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:components="clr-namespace:Vanguard.VCS.Client.UI.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <StackPanel
                Background="#E9E9E9"
                Height="40"
                Margin="0,0">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="5,0,0,0"
                    Text="SRS Interface"
                    VerticalAlignment="Center" />
                <TextBlock Margin="5,-8,0,0" Text="Old Settings" />
            </StackPanel>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <components:ToggleGlobalSetting
                Height="50"
                SettingKey="RadioOverlayTaskbarHide"
                Title="Hide Overlay Taskbar Item" />
            <components:ToggleGlobalSetting
                Height="50"
                SettingKey="RefocusDCS"
                Title="Auto Refocus DCS" />

            <StackPanel
                Background="#E9E9E9"
                Height="40"
                Margin="0,0">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="5,0,0,0"
                    Text="Miscellaneous"
                    VerticalAlignment="Center" />
                <TextBlock Margin="5,-8,0,0" Text="Old Settings" />
            </StackPanel>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <components:ToggleGlobalSetting
                Height="50"
                SettingKey="AutoSelectSettingsProfile"
                Title="Auto select Profile for Aircraft" />
            <components:ToggleGlobalSetting
                Height="50"
                SettingKey="CheckForBetaUpdates"
                Title="Check for Beta updates" />
            <Grid Height="50" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label
                        Content="Set SRS Path for DCS"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center" />
                </StackPanel>

                <Button
                    Click="SetSRSPath_Click"
                    Content="SET PATH"
                    Grid.Column="1"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="100" />
            </Grid>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <components:ToggleGlobalSetting
                Height="50"
                SettingKey="RequireAdmin"
                Title="Require Admin" />
            <components:ToggleGlobalSetting
                Height="50"
                SettingKey="VAICOMTXInhibitEnabled"
                Title="Allow VAICOM TX Inhibit" />
            <components:ToggleGlobalSetting
                Height="50"
                SettingKey="PlayConnectionSounds"
                Title="Play connection sounds" />

            <StackPanel
                Background="#E9E9E9"
                Height="40"
                Margin="0,0">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="5,0,0,0"
                    Text="Controls / Cockpit Integration"
                    VerticalAlignment="Center" />
                <TextBlock Margin="5,-8,0,0" Text="Old Settings" />
            </StackPanel>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <components:ToggleProfileSetting
                Height="50"
                SettingKey="AutoSelectPresetChannel"
                Title="Auto Select First Channel Presets" />
            <components:ToggleProfileSetting
                Height="50"
                SettingKey="AlwaysAllowHotasControls"
                Title="ALWAYS allow SRS Hotkeys" />
            <components:ToggleProfileSetting
                Height="50"
                SettingKey="AlwaysAllowTransponderOverlay"
                Title="ALWAYS allow Transponder Overlay Controls" />
            <components:ToggleProfileSetting
                Height="50"
                SettingKey="AllowDCSPTT"
                Title="Allow INCOCKPIT DCS Controlled PTT" />
            <components:ToggleProfileSetting
                Height="50"
                SettingKey="RotaryStyleIncrement"
                Title="Rotary Style Frequency Increment/Decrement" />

            <StackPanel
                Background="#E9E9E9"
                Height="40"
                Margin="0,0">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="5,0,0,0"
                    Text="Radio Effects Settings"
                    VerticalAlignment="Center" />
                <TextBlock Margin="5,-8,0,0" Text="Old Settings" />
            </StackPanel>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <components:ToggleProfileSetting
                Height="50"
                SettingKey="MIDSRadioEffect"
                SubTitle="Requires Tx or Rx Effects on"
                Title="MIDS Tx &amp; Rx Effects" />
            <Grid Height="110" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label
                        Content="Enable FM Radio Tone"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10">

                    <ToggleButton
                        Checked="ToggleButton_OnChecked"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,5"
                        Unchecked="ToggleButton_OnUnchecked"
                        x:Name="ToggleButton" />

                    <Slider
                        IsEnabled="False"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        Maximum="200"
                        Minimum="0"
                        SmallChange="5"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="100"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        x:Name="NATOToneVolume" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Content="0%"
                            FontSize="10"
                            Grid.Column="0"
                            HorizontalAlignment="Left" />
                        <Label
                            Content="100%"
                            FontSize="10"
                            Grid.Column="1"
                            HorizontalAlignment="Center" />
                        <Label
                            Content="200%"
                            FontSize="10"
                            Grid.Column="2"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="110" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label
                        Content="Enable HAVEQUICK Effect"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10">

                    <ToggleButton
                        Checked="HaveToggleButton_OnChecked"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,5"
                        Unchecked="HaveToggleButton_OnUnchecked"
                        x:Name="HaveToggleButton" />

                    <Slider
                        IsEnabled="False"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        Maximum="200"
                        Minimum="0"
                        SmallChange="5"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="100"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        x:Name="HQToneVolume" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Content="0%"
                            FontSize="10"
                            Grid.Column="0"
                            HorizontalAlignment="Left" />
                        <Label
                            Content="100%"
                            FontSize="10"
                            Grid.Column="1"
                            HorizontalAlignment="Center" />
                        <Label
                            Content="200%"
                            FontSize="10"
                            Grid.Column="2"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <components:ToggleProfileSetting
                Height="50"
                SettingKey="RadioBackgroundNoiseEffect"
                SubTitle="(UHF/VHF/HF/FM)"
                Title="Enable Background Radio Effects" />
            <Grid Height="80" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label
                        Content="UHF Effect Volume"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="10"
                    VerticalAlignment="Center">

                    <Slider
                        IsEnabled="False"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        Maximum="200"
                        Minimum="0"
                        SmallChange="5"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="100"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        x:Name="UHFEffectVolume" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Content="0%"
                            FontSize="10"
                            Grid.Column="0"
                            HorizontalAlignment="Left" />
                        <Label
                            Content="100%"
                            FontSize="10"
                            Grid.Column="1"
                            HorizontalAlignment="Center" />
                        <Label
                            Content="200%"
                            FontSize="10"
                            Grid.Column="2"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="80" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label
                        Content="VHF Effect Volume"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="10"
                    VerticalAlignment="Center">

                    <Slider
                        IsEnabled="False"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        Maximum="200"
                        Minimum="0"
                        SmallChange="5"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="100"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        x:Name="VHFEffectVolume" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Content="0%"
                            FontSize="10"
                            Grid.Column="0"
                            HorizontalAlignment="Left" />
                        <Label
                            Content="100%"
                            FontSize="10"
                            Grid.Column="1"
                            HorizontalAlignment="Center" />
                        <Label
                            Content="200%"
                            FontSize="10"
                            Grid.Column="2"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="80" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label
                        Content="HF Effect Volume"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="10"
                    VerticalAlignment="Center">

                    <Slider
                        IsEnabled="False"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        Maximum="200"
                        Minimum="0"
                        SmallChange="5"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="100"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        x:Name="HFEffectVolume" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Content="0%"
                            FontSize="10"
                            Grid.Column="0"
                            HorizontalAlignment="Left" />
                        <Label
                            Content="100%"
                            FontSize="10"
                            Grid.Column="1"
                            HorizontalAlignment="Center" />
                        <Label
                            Content="200%"
                            FontSize="10"
                            Grid.Column="2"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Grid Height="80" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label
                        Content="FM Effect Volume"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="10"
                    VerticalAlignment="Center">

                    <Slider
                        IsEnabled="False"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        Maximum="200"
                        Minimum="0"
                        SmallChange="5"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="100"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        x:Name="FMEffectVolume" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Content="0%"
                            FontSize="10"
                            Grid.Column="0"
                            HorizontalAlignment="Left" />
                        <Label
                            Content="100%"
                            FontSize="10"
                            Grid.Column="1"
                            HorizontalAlignment="Center" />
                        <Label
                            Content="200%"
                            FontSize="10"
                            Grid.Column="2"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                VerticalAlignment="Bottom" />

            <Separator
                BorderBrush="White"
                BorderThickness="40"
                VerticalAlignment="Bottom" />
        </StackPanel>
    </ScrollViewer>
</Page>
