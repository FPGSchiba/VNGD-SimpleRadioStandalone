<Page
    Height="270"
    Title="CommunicationsPage"
    Width="415"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.ClientWindow.HomePages.CommunicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:DialogHost
            CloseOnClickAway="True"
            DialogContentUniformCornerRadius="20"
            DialogTheme="Inherit"
            Grid.Row="0"
            Identifier="PanelDialog">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="60" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>

                        <!--  Normal Panels  -->
                        <Button
                            Click="PanelButton_OnClick"
                            Content="1 Vertical"
                            Grid.Column="0"
                            Grid.Row="0"
                            Height="30"
                            Margin="10,10,10,0"
                            x:Name="Vertical1" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="1 Horizontal"
                            Grid.Column="0"
                            Grid.Row="1"
                            Height="30"
                            Margin="10,10,10,0"
                            x:Name="Horizontal1" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="2 Vertical"
                            Grid.Column="1"
                            Grid.Row="0"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Vertical2" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="2 Horizontal"
                            Grid.Column="1"
                            Grid.Row="1"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Horizontal2" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="3 Vertical"
                            Grid.Column="2"
                            Grid.Row="0"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Vertical3" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="3 Horizontal"
                            Grid.Column="2"
                            Grid.Row="1"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Horizontal3" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="5 Vertical"
                            Grid.Column="3"
                            Grid.Row="0"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Vertical5" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="5 Horizontal"
                            Grid.Column="3"
                            Grid.Row="1"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Horizontal5" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="10 Vertical"
                            Grid.Column="4"
                            Grid.Row="0"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Vertical10" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="10 Horizontal"
                            Grid.Column="4"
                            Grid.Row="1"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Horizontal10" />

                        <!--  Special Panels  -->
                        <Button
                            Click="PanelButton_OnClick"
                            Content="10 Vertical Ultralong"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Grid.Row="2"
                            Height="30"
                            Margin="10,10,10,0"
                            x:Name="Long10" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="10 Vertical Ultrawide"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Grid.Row="3"
                            Height="30"
                            Margin="10,10,10,10"
                            x:Name="Wide10" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="Original Compact"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Grid.Row="2"
                            Height="30"
                            Margin="0,10,10,0"
                            x:Name="Compact" />
                        <Button
                            Click="PanelButton_OnClick"
                            Content="Switchable Compact"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Grid.Row="3"
                            Height="30"
                            Margin="0,10,10,10"
                            x:Name="Switch" />
                    </Grid>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button
                        Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}"
                        Content="SELECT RADIO PANEL"
                        Height="40"
                        Margin="0,100,0,0"
                        Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                        Width="200"
                        materialDesign:ButtonAssist.CornerRadius="25" />

                </StackPanel>
            </StackPanel>
        </materialDesign:DialogHost>
    </Grid>
</Page>
