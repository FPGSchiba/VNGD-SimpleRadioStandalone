<Page
    Height="270"
    Title="ServerDetailsPage"
    Width="415"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.ClientWindow.HomePages.ServerDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Label
                Content="Coalition Security"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="0"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="0"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="CoalitionSecurity" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="0"
                VerticalAlignment="Bottom" />

            <Label
                Content="Spectator Audio"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="1"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="SpectatorAudio" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="1"
                VerticalAlignment="Bottom" />

            <Label
                Content="Line of Sight"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="2"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="2"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="LineOfSight" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="2"
                VerticalAlignment="Bottom" />

            <Label
                Content="Distance Limitations"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="3"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="3"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="DistanceLimitations" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="3"
                VerticalAlignment="Bottom" />

            <Label
                Content="IRL Radio Tx Behaviour"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="4"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="4"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="RealRadioBehaviour" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="4"
                VerticalAlignment="Bottom" />

            <Label
                Content="IRL Radio Rx Interfence"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="5"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="5"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="RealRadioInterface" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="5"
                VerticalAlignment="Bottom" />

            <Label
                Content="Radio Expansion"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="6"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="6"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="RadioExpansion" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="6"
                VerticalAlignment="Bottom" />

            <Label
                Content="External AWACS Mode"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="7"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="7"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="ExternalMode" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="7"
                VerticalAlignment="Bottom" />

            <Label
                Content="Allow Radio Encryption"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="8"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="8"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="RadioEncryption" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="8"
                VerticalAlignment="Bottom" />

            <Label
                Content="Strict Radio Encryption"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="9"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="9"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="StrictEncryption" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="9"
                VerticalAlignment="Bottom" />

            <Label
                Content="Show Tuned Client Count"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="10"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="10"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="TunedClientCount" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="10"
                VerticalAlignment="Bottom" />

            <Label
                Content="Show Transmitter Name"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="11"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Button
                BorderBrush="Black"
                BorderThickness="1"
                Content="OFF"
                Grid.Column="1"
                Grid.Row="11"
                IsEnabled="False"
                Margin="0,0,10,0"
                Opacity="1"
                Style="{StaticResource MaterialDesignRaisedLightButton}"
                x:Name="TransmitterName" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="11"
                VerticalAlignment="Bottom" />

            <Label
                Content="Server Version"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="12"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Label
                Content="none"
                Foreground="#555"
                Grid.Column="1"
                Grid.Row="12"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                x:Name="ServerVersion" />
            <Separator
                BorderBrush="Black"
                BorderThickness="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="12"
                VerticalAlignment="Bottom" />

            <Label
                Content="Retransmit Node Limit"
                FontSize="14"
                Grid.Column="0"
                Grid.Row="13"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
            <Label
                Content="none"
                Foreground="#555"
                Grid.Column="1"
                Grid.Row="13"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                x:Name="RetransmitLimit" />
        </Grid>
    </ScrollViewer>
</Page>
