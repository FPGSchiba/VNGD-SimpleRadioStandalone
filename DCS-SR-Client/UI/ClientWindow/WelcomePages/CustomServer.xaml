<Page x:Class="Vanguard.VCS.Client.UI.ClientWindow.WelcomePages.CustomServer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Vanguard.VCS.Client.UI.ClientWindow.WelcomePages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Height="340"
      Title="CustomServerPage"
      Width="600"
      d:DesignHeight="340"
      d:DesignWidth="600">
    <Grid KeyDown="OnButtonPressed">
        <Grid.Background>
            <SolidColorBrush Color="White" />
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="40" />
            <RowDefinition Height="200" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.ColumnSpan="2"
            Grid.Row="0"
            VerticalAlignment="Bottom">
            <Label
                Content="Vanguard Communications System"
                FontSize="24"
                FontWeight="Heavy"
                HorizontalAlignment="Center"
                Margin="0,0,0,-13" />
            <Label
                Content="powered by SRS"
                FontSize="16"
                HorizontalAlignment="Center" />
        </StackPanel>
        

        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            VerticalAlignment="Top">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Vertical"
                VerticalAlignment="Center">
                <TextBox
                    AcceptsReturn="False"
                    FontSize="16"
                    Height="38"
                    HorizontalAlignment="Right"
                    IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignOutlinedTextBoxEnabledComboBox}"
                    Margin="0,0,10,0"
                    Name="IpInput"
                    Padding="7"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Top"
                    Width="180"
                    materialDesign:HintAssist.Hint="IP Address" />
                <materialDesign:NumericUpDown
                    FontSize="16"
                    Height="38"
                    HorizontalAlignment="Right"
                    IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignOutlinedTextBoxEnabledComboBox}"
                    Margin="0,10,10,0"
                    Name="PortInput"
                    Padding="7"
                    Style="{StaticResource MaterialDesignOutlinedNumericUpDown}"
                    VerticalAlignment="Top"
                    Width="120"
                    materialDesign:HintAssist.Hint="Port"/>
            </StackPanel>
            
            <Button
                Click="Connect_OnClick"
                Content="CONNECT"
                Height="30"
                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                Margin="10,0,0,0"
                Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                Width="120"
                materialDesign:ButtonAssist.CornerRadius="15"
                x:Name="Connect" />
            <ProgressBar
                Height="30"
                IsIndeterminate="True"
                Margin="10,0,0,0"
                Name="ConnectInProgress"
                Opacity="0"
                Style="{StaticResource MaterialDesignCircularProgressBar}"
                Value="0"
                Width="30" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            
        </StackPanel>


        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Button
                Click="Back_OnClick"
                Content="Back"
                Height="30"
                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                Margin="10,0,0,0"
                Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                VerticalAlignment="Top"
                Width="70"
                materialDesign:ButtonAssist.CornerRadius="15"
                x:Name="Back" />
        </StackPanel>
        
        <StackPanel Grid.Row="3" Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <Button
                Click="Continue_OnClick"
                Content="CONTINUE"
                Height="30"
                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                Margin="0,0,10,10"
                Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                VerticalAlignment="Top"
                Width="120"
                materialDesign:ButtonAssist.CornerRadius="15"
                x:Name="Continue" />
        </StackPanel>
    </Grid>
</Page>
