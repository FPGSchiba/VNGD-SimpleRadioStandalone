<UserControl
    d:DesignHeight="100"
    d:DesignWidth="400"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Client.UI.ClientWindow.InputBindingListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:components="clr-namespace:Vanguard.VCS.Client.UI.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:input="clr-namespace:Vanguard.VCS.Client.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ControlsBindGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>

        <components:InputBindingControl />
        <Button
            Content="Add Binding"
            Grid.Column="2"
            x:Name="NewButton" />
    </Grid>
</UserControl>
