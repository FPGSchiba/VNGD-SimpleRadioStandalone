<UserControl
    Height="575"
    Width="330"
    mc:Ignorable="d"
    x:Class="Vanguard.VCS.Server.UI.MainWindow.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vanguard.VCS.Server.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Margin="0,0,0,0" VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="5" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Button
                    Content="{Binding ServerButtonText}"
                    Grid.Column="0"
                    Grid.Row="0"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="ServerStartStop" />

                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                    Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Content="Clients:"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="55" />
                        <Label
                            Content="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="44"
                            x:Name="ClientsCount" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Content="Port:"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="55" />
                        <Label
                            Content="5002"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="44"
                            x:Name="ListeningPort" />
                    </StackPanel>


                </StackPanel>


                <Button
                    Content="Client Admin"
                    Grid.Column="2"
                    Grid.Row="0"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="ShowClientList" />

                <Label
                    Content="Secure Coalition Radios"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding RadioSecurityText}"
                    Grid.Column="2"
                    Grid.Row="1"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="RadioSecurityToggle" />

                <Label
                    Content="Spectator Audio"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding SpectatorAudioText}"
                    Grid.Column="2"
                    Grid.Row="2"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="SpectatorAudioToggle" />

                <Label
                    Content="Auto Export List"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding ExportListText}"
                    Grid.Column="2"
                    Grid.Row="3"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="ExportListToggle" />

                <Label
                    Content="Line of Sight"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding LOSText}"
                    Grid.Column="2"
                    Grid.Row="4"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="LOSToggle" />

                <Label
                    Content="Distance Limit"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding DistanceLimitText}"
                    Grid.Column="2"
                    Grid.Row="5"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="DistanceLimitToggle" />

                <Label
                    Content="IRL Radio Tx Behaviour"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding RealRadioText}"
                    Grid.Column="2"
                    Grid.Row="6"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="RealRadioToggle" />

                <Label
                    Content="IRL Radio Rx Behaviour"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="7"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding IRLRadioRxText}"
                    Grid.Column="2"
                    Grid.Row="7"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="IRLRadioRxBehaviourToggle" />

                <Label
                    Content="Radio Expansion"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding RadioExpansion}"
                    Grid.Column="2"
                    Grid.Row="8"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="RadioExpansionToggle" />

                <Label
                    Content="Allow Radio Encryption"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="9"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding AllowRadioEncryption}"
                    Grid.Column="2"
                    Grid.Row="9"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="AllowRadioEncryptionToggle" />

                <Label
                    Content="Strict Radio Encryption"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding StrictRadioEncryption}"
                    Grid.Column="2"
                    Grid.Row="10"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="StrictRadioEncryptionToggle" />

                <Label
                    Content="Check for beta updates"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="11"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding CheckForBetaUpdates}"
                    Grid.Column="2"
                    Grid.Row="11"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="CheckForBetaUpdatesToggle" />


                <Label
                    Content="External AWACS Mode (EAM)"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding ExternalAWACSMode}"
                    Grid.Column="2"
                    Grid.Row="12"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="ExternalAWACSModeToggle" />

                <Label
                    Content="EAM blue coal. password"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="13"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Column="2"
                    Grid.Row="13"
                    Height="20"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding IsExternalAWACSModeEnabled}"
                    Text="{Binding Path=ExternalAWACSModeBluePassword, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="ExternalAWACSModeBluePassword" />

                <Label
                    Content="EAM red coal. password"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Column="2"
                    Grid.Row="14"
                    Height="20"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding IsExternalAWACSModeEnabled}"
                    Text="{Binding Path=ExternalAWACSModeRedPassword, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="ExternalAWACSModeRedPassword" />

                <Label
                    Content="Test Frequencies AM (MHz)"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="15"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Column="2"
                    Grid.Row="15"
                    Height="20"
                    HorizontalAlignment="Center"
                    IsEnabled="True"
                    Text="247.2,120.3"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="TestFrequencies" />


                <Label
                    Content="Show Tuned/Client Count"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding TunedCountText}"
                    Grid.Column="2"
                    Grid.Row="16"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="TunedCountToggle" />

                <Label
                    Content="Global Lobby Freq. AM (MHz)"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="17"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Column="2"
                    Grid.Row="17"
                    Height="20"
                    HorizontalAlignment="Center"
                    IsEnabled="True"
                    Text="241.2,122.3"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="GlobalLobbyFrequencies" />

                <Label
                    Content="Ignore Radio Effect on Global Freq"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding OverrideEffectsOnGlobal}"
                    Grid.Column="2"
                    Grid.Row="18"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="OverrideEffectsOnGlobalToggle" />

                <Label
                    Content="LotATC Transponder Export"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="19"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding LotATCExportText}"
                    Grid.Column="2"
                    Grid.Row="19"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="LotATCExportToggle" />

                <Label
                    Content="Show Transmitter Name"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding ShowTransmitterNameText}"
                    Grid.Column="2"
                    Grid.Row="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="ShowTransmitterNameToggle" />

                <Label
                    Content="Log Received Transmissions"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="21"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <Button
                    Content="{Binding TransmissionLogEnabledText}"
                    Grid.Column="2"
                    Grid.Row="21"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="75"
                    x:Name="TransmissionLogEnabledToggle" />

                <Label
                    Content="Transmission Archive Time"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="22"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Column="2"
                    Grid.Row="22"
                    Orientation="Vertical">
                    <Grid Width="75">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Content="0"
                            FontSize="10"
                            Grid.Column="0"
                            HorizontalAlignment="Left" />
                        <Label
                            Content="7"
                            FontSize="10"
                            Grid.Column="1"
                            HorizontalAlignment="Right" />
                    </Grid>

                    <Slider
                        Height="40"
                        HorizontalAlignment="Center"
                        Interval="1"
                        IsSnapToTickEnabled="True"
                        Maximum="7"
                        Minimum="0"
                        TickPlacement="TopLeft"
                        Ticks="1,2,3,4,5,6,7"
                        Value="{Binding ArchiveLimit}"
                        VerticalAlignment="Center"
                        Width="75" />
                </StackPanel>

                <Label
                    Content="Retransmit Hop/Node Count"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="23"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="2"
                    Grid.Row="23"
                    Orientation="Vertical">
                    <Grid Width="75">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Content="0"
                            FontSize="10"
                            Grid.Column="0"
                            HorizontalAlignment="Left" />
                        <Label
                            Content="5"
                            FontSize="10"
                            Grid.Column="1"
                            HorizontalAlignment="Right" />
                    </Grid>
                    <Slider
                        Height="40"
                        HorizontalAlignment="Center"
                        Interval="1"
                        IsSnapToTickEnabled="True"
                        Maximum="5"
                        Minimum="0"
                        TickPlacement="TopLeft"
                        Ticks="0,1,2,3,4,5"
                        Value="{Binding NodeLimit}"
                        VerticalAlignment="Center"
                        Width="75" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>