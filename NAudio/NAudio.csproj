<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NAudio</AssemblyName>
    <RootNamespace>NAudio</RootNamespace>

    <!-- Assembly attributes from AssemblyInfo.cs -->
    <Title>NAudio</Title>
    <Description>NAudio .NET Audio Library</Description>
    <Company>Mark Heath</Company>
    <Product>NAudio</Product>
    <Copyright>© 2001-2017 Mark Heath</Copyright>
    <AssemblyVersion>1.8.4.0</AssemblyVersion>
    <FileVersion>1.8.4.0</FileVersion>
    <Version>1.8.4.0</Version>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Disable auto-generation of AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- InternalsVisibleTo attribute -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NAudioTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- COM GUID -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>e82fa7f0-f952-4d93-b7b0-392bbf53b2a4</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>
</Project>